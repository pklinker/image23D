# Copy to .env and adjust for this host. Weights live outside this repo and
# outside the image (PLAN.md sec.3: mounted volume, not baked in) so a rented
# GPU box later is just a compose-file + .env change.
#
# On the current dev box the weights are split across two ComfyUI installs --
# see PHASE1.md for why.
COMFY_MODELS_VAE=/home/pklinker/comfyui/ComfyUI/models/vae
COMFY_MODELS_BACKGROUND_REMOVAL=/home/pklinker/comfyui/ComfyUI/models/background_removal
COMFY_MODELS_CLIP_VISION=/home/pklinker/comfyui/ComfyUI/models/clip_vision
COMFY_MODELS_GEOMETRY_ESTIMATION=/home/pklinker/comfyui/ComfyUI/models/geometry_estimation
COMFY_MODELS_DIFFUSION_MODELS=/apps/comfyui/models/diffusion_models

COMFY_PORT=8188

# --- Phase 2: API / queue / DB / object store ---
# Service-to-service URLs use the compose network's service names; the
# S3_PUBLIC_ENDPOINT_URL is what a browser holding a presigned URL will
# actually hit, so it has to be the host-reachable address, not "minio".
DATABASE_URL=postgresql+asyncpg://image23d:image23d@postgres:5432/image23d
POSTGRES_DB=image23d
POSTGRES_USER=image23d
POSTGRES_PASSWORD=image23d

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=image23d
S3_SECRET_KEY=image23d-dev-secret
S3_BUCKET=image23d
S3_REGION=us-east-1

COMFY_BASE_URL=http://comfy-worker:8188
COMFY_SHARED_INPUT_DIR=/app/ComfyUI/input
COMFY_SHARED_OUTPUT_DIR=/app/ComfyUI/output
PIPELINE_BACKEND=embedded

PRESIGNED_URL_TTL_SECONDS=3600

# --- Phase 3: viewer ---
VIEWER_ORIGIN=http://localhost:5173
VIEWER_API_BASE_URL=http://localhost:8000

# --- Phase 4: hardening ---
RATE_LIMIT_JOB_CREATION_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RETENTION_DAYS=30
